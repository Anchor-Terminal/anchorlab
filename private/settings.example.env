# private/settings.example.env: copy to private/settings.env and fill in. KEY=value lines, read by
# build.sh, models/fetch.sh and models/install.sh. private/settings.env is ignored by git.

# the private bench set, built in by ./build.sh when no file is given on the command line
ANCHOR_LAB_BENCH_CASES=

# the models folder, for models/fetch.sh and models/install.sh
MODELS=/srv/models
