# The door to the cells. The harness connects here once for each program a model wrote, and systemd
# starts a cell for that connection alone (anchor-lab-cell@.service). Only the harness's user can
# connect. Installed by install.sh; DESIGN.md has the reasons.
[Unit]
Description=Anchor lab: a cell for each connection

[Socket]
ListenStream=/run/anchor-lab/cell.sock
SocketUser=anchorlab
SocketGroup=anchorlab
SocketMode=0600
# systemd makes /run/anchor-lab as root with this mode; SocketUser applies to the socket alone. The
# folder has to let anchorlab through to reach the socket, and the socket's own 0600 is what keeps
# everyone else out. 0750 here left the harness with "permission denied" on the box's first run.
DirectoryMode=0755
Accept=yes
# programs run one at a time today; this is the ceiling if that changes
MaxConnections=4

[Install]
WantedBy=sockets.target
