# One cell: it builds and runs one program a model wrote, then exits. Everything a cell can touch
# is decided here, by root, in a file. The harness can't pass it an option, and neither can the
# program. What a cell has:
#   - the connection it was started with, to the harness (standard input and output), and nothing
#     else to talk to: no network of any kind, not even this machine's own
#   - a user made for this run and gone after it
#   - a private /tmp to build in, in memory, counted against its memory limit
#   - the system's files read-only, with /home, /root, /var, /etc/anchor-lab, /srv, /mnt and /media hidden
#   - limits on memory, processes, CPU and time
[Unit]
Description=Anchor lab cell %i
CollectMode=inactive-or-failed

[Service]
ExecStart=/usr/local/bin/anchor-lab cell
StandardInput=socket
StandardOutput=socket
StandardError=journal
Environment=PATH=/usr/local/go/bin:/usr/lib/go/bin:/usr/bin:/bin HOME=/tmp TMPDIR=/tmp

DynamicUser=yes
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=none
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
PrivateIPC=yes
ProtectSystem=strict
ProtectHome=yes
TemporaryFileSystem=/var:ro /srv:ro /mnt:ro /media:ro /opt:ro
InaccessiblePaths=-/etc/anchor-lab -/etc/ssh -/etc/shadow -/etc/sudoers -/etc/sudoers.d -/boot -/root
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
# a call outside the filter fails with an error; the default would kill the process, the Go toolchain included
SystemCallErrorNumber=EPERM
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @reboot @swap @debug @module @raw-io @cpu-emulation @obsolete
UMask=0077
KeyringMode=private

MemoryMax=6G
MemorySwapMax=0
TasksMax=512
CPUQuota=800%
LimitNOFILE=4096
LimitFSIZE=1G
LimitCORE=0
# a build may take 3 minutes and a run 2 (lab/cell/cell.go); past this the cell is killed whatever it's doing
RuntimeMaxSec=420
TimeoutStopSec=5
KillMode=control-group
OOMPolicy=kill
