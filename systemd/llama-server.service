# llama.cpp's server for the lab's models, in router mode: one process that loads the model a request
# names (from /etc/llama/models.ini) and unloads the one before. It listens on this machine only,
# where the harness expects it, reads the models folder and nothing else of ours, and reaches no
# network: models are downloaded beforehand with models/fetch.sh, never by the server.
# Installed by models/install.sh (MODELS.md).
[Unit]
Description=llama.cpp model server for the lab
After=network.target

[Service]
User=llama
Group=llama
SupplementaryGroups=render video
ExecStart=/usr/local/bin/llama-server --models-preset /etc/llama/models.ini --models-max 1 --host 127.0.0.1 --port 8080
Environment=LLAMA_CACHE=/var/lib/llama/cache
StateDirectory=llama
StateDirectoryMode=0750
Restart=on-failure
RestartSec=10
TimeoutStopSec=60

ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=@MODELS@
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
IPAddressDeny=any
IPAddressAllow=localhost
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
